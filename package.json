{
    "name": "bouc.io-agent-api-server",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "nodemon src/index.ts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:deploy": "npx prisma migrate deploy && npx prisma generate",
        "db:seed": "node dist/scripts/seed.js",
        "db:seed:dev": "ts-node src/scripts/seed.ts",
        "test": "vitest run",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "test:watch": "vitest"
    },
    "keywords": [
        "ai-agent",
        "llm",
        "tool-calling",
        "rag",
        "kubernetes",
        "sse"
    ],
    "author": "",
    "license": "Elastic-2.0",
    "description": "Agentic backend for the bouc.io AI assistant platform — two-phase planner/executor loop with tool calling, memory retrieval, and SSE streaming.",
    "prisma": {
        "seed": "npm run db:seed"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.76.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
        "@opentelemetry/resources": "^2.7.1",
        "@opentelemetry/sdk-metrics": "^2.7.1",
        "@opentelemetry/sdk-node": "^0.218.0",
        "@opentelemetry/semantic-conventions": "^1.41.1",
        "@prisma/client": "^6.10.1",
        "axios": "^1.18.0",
        "bullmq": "^5.34.0",
        "cheerio": "^1.2.0",
        "cors": "^2.8.5",
        "dayjs": "^1.11.19",
        "dotenv": "^16.5.0",
        "duck-duck-scrape": "^2.2.7",
        "express": "^4.21.2",
        "express-rate-limit": "^8.0.1",
        "helmet": "^8.2.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.3",
        "mathjs": "^14.9.1",
        "pino": "^9.4.0",
        "prom-client": "^15.1.3",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.0.14",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "prisma": "^6.10.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3",
        "vitest": "^4.1.7"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.com/bouc-io/application/agent/agent-api-server.git"
    }
}
