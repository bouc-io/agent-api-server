DATABASE_URL="postgresql://<USR>:<PWD>@localhost:5432/agentdb"
PORT=3000
REDIS_URL="redis://localhost:6379"

# LLM Configuration
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:2b"
OLLAMA_API_TOKEN="<your-token-here>"
OLLAMA_REFRESH_TOKEN="<your-refresh-token-here>"
# Ollama sampling parameters (tune generation; defaults shown)
OLLAMA_NUM_CTX="4096"            # context window size sent to Ollama
OLLAMA_TOP_K="25"                # top-k sampling
OLLAMA_TOP_P="0.85"              # nucleus sampling threshold
OLLAMA_REPEAT_PENALTY="1.15"     # penalize token repetition

# OAuth2 Configuration (for token refresh)
OAUTH_TOKEN_ENDPOINT="https://sso.pik8s.internal/realms/users/protocol/openid-connect/token"
OAUTH_CLIENT_ID="oauth2-proxy"

# SSL/TLS Configuration
# Set to "true" for self-signed certs (dev, docker-desktop, raspberry pi clusters)
# Set to "false" for production with proper CA-signed certificates
ALLOW_SELF_SIGNED_CERTS="true"

NODE_ENV="development"
# Logging Configuration
LOG_LEVEL="info"

# Conversation history window (most recent N messages sent to the LLM)
MAX_HISTORY_MESSAGES="10"

# Harness resilience & budget (Phase 4)
MAX_EXECUTION_STEPS="10"           # max executor iterations per run
EXECUTOR_TIMEOUT_MS="300000"       # wall-clock guard for the executor phase (5 min)
LLM_BREAKER_THRESHOLD="5"          # consecutive Ollama failures before the circuit opens
LLM_BREAKER_COOLDOWN_MS="30000"    # how long the breaker stays open before a half-open trial
OLLAMA_KEEP_ALIVE="10m"            # keep the model resident between calls (warm prompt/weights)
SSE_HEARTBEAT_MS="15000"           # SSE keep-alive ping interval

# Eval harness: master switch for HITL auto-approval. When "true", runs that opt in
# via options.eval_mode=true will auto-approve tools behind the approval gate instead
# of parking for a human (headless evals have no one to click approve). Per-run flag is
# ignored unless this is set, so LEAVE UNSET/false in production to keep the human gate.
EVAL_AUTO_APPROVE="false"

# Tool Execution Configuration
TOOL_DEFAULT_TIMEOUT_MS="30000"

# Memory Service Configuration
MEMORY_SERVICE_URL="https://memory.pik8s.internal"
MEMORY_SERVICE_ENABLED="true"

# Distillation Service Configuration
DISTILLATION_SERVICE_URL="https://memory.pik8s.internal"
DISTILLATION_ENABLED="true"
DISTILLATION_TIMEOUT_MS="120000"   # timeout for the post-run distillation call

# Instruction Services (GAP 4 — global+org instructions from admin, personal from portal)
ADMIN_API_URL="http://admin-api-chart.default.svc.cluster.local:80"
PORTAL_API_URL="http://portal-api-chart.default.svc.cluster.local:80"

# MCP (Model Context Protocol) client — external MCP servers are configured in
# admin-api-server (/v1/admin/mcp-servers) and fetched here at runtime via
# ADMIN_API_URL. How often (ms) to re-sync that list and retry failed servers.
MCP_SYNC_INTERVAL_MS="60000"

# Observability (Phase 6b) — traces to the OTel collector; metrics at /metrics
# Leave OTEL unset locally to disable tracing entirely (no-op, no connection errors).
OTEL_EXPORTER_OTLP_ENDPOINT=""        # in-cluster: http://$(HOST_IP):4318 (node IP — the collector is a hostNetwork daemonset, not a ClusterIP service; the chart injects HOST_IP via the downward API)
OTEL_ENABLED="false"                   # or "true" to force-enable tracing
OTEL_SERVICE_NAME="agent-api-server"

# Sandboxed code execution (code_execute tool). Opt-in: the tool is only exposed to
# the model when ALLOW_CODE_EXECUTE=true AND a container runtime is reachable.
ALLOW_CODE_EXECUTE="false"
SANDBOX_IMAGE="python:3.11-slim"     # locked-down image; must contain the interpreter(s) you allow
SANDBOX_TIMEOUT_MS="10000"           # default wall-clock timeout per run (max 60000)
SANDBOX_MEMORY="256m"                # container memory limit
SANDBOX_CPUS="1"                     # container CPU limit
SANDBOX_PIDS="128"                   # max processes (fork-bomb guard)
